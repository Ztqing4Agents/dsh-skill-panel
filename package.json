{
  "name": "@ztqing4agents/dsh-skill-panel",
  "version": "1.1.3",
  "type": "module",
  "description": "Skill panel for the DSH GUI: built-in, local and market-installed skills in one list, each with its own switch.",
  "icon": "assets/icon.svg",
  "license": "MIT",
  "author": {
    "name": "Ztqing"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ztqing4Agents/dsh-skill-panel.git"
  },
  "homepage": "https://github.com/Ztqing4Agents/dsh-skill-panel#readme",
  "bugs": {
    "url": "https://github.com/Ztqing4Agents/dsh-skill-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skills",
    "skill-manager"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:hosts": "node scripts/sync-hosts.mjs",
    "check:board": "node scripts/check-board.mjs",
    "check:docs:standards": "node scripts/check-docs-standards.mjs",
    "check": "npm run check:i18n && npm run check:client && npm run check:docs && npm run check:hosts && npm run check:board",
    "test": "node --test test/",
    "test:compat": "node scripts/test-compat.mjs",
    "prepublishOnly": "npm run check && npm test && node scripts/check-version.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-0 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  }
}
