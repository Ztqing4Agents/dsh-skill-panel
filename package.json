{
  "name": "dsh-skill-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH skill center: tell built-in, local, and market-installed skills apart at a glance, and switch each one on or off.",
  "icon": "assets/icon.svg",
  "license": "BSD-3-Clause",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:board": "node scripts/check-board.mjs",
    "check": "npm run check:i18n && npm run check:client && npm run check:docs && npm run check:board",
    "test": "node --test test/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1"
  }
}
